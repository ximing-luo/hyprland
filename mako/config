# 基础设置
default-timeout=5000
border-radius=12
font=JetBrainsMono Nerd Font 11
max-visible=5
icons=1
max-icon-size=64

# 颜色主题 - Catppuccin Mocha (带透明度)
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#89b4fa
border-size=2
progress-color=over #313244

# 布局
anchor=top-center
margin=20
padding=15
width=300
border-radius=10

# 文本格式
markup=1
format=<b>%s</b>\n%b
text-alignment=center

# 紧急程度样式覆盖
[urgency=high]
border-color=#f38ba8
default-timeout=0

[urgency=low]
border-color=#313244
default-timeout=2000

# 分组设置
[grouped]
format=<b>%s (共有 %g 条通知)</b>\n%b

